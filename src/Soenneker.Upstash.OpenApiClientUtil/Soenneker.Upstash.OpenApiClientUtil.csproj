<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Description>A thread-safe utility for obtaining Upstash's OpenApiClient singleton.</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">4.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Upstash.OpenApiClientUtil</AssemblyName>
        <PackageId>Soenneker.Upstash.OpenApiClientUtil</PackageId>
        <PackageTags>upstash openapiclientutil redis vector management openapi kiota client util singleton upstashopenapiclientutil csharp dotnet c# .net</PackageTags>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.upstash.openapiclientutil</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.upstash.openapiclientutil</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <LangVersion>latest</LangVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Upstash.HttpClients" Version="4.0.1" Condition="'$(UseLocalUpstashProjects)' != 'true'" />
        <PackageReference Include="Soenneker.Upstash.OpenApiClient" Version="4.0.1" Condition="'$(UseLocalUpstashProjects)' != 'true'" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseLocalUpstashProjects)' == 'true'">
        <ProjectReference Include="../../../soenneker.upstash.httpclients/src/Soenneker.Upstash.HttpClients/Soenneker.Upstash.HttpClients.csproj" />
        <ProjectReference Include="../../../soenneker.upstash.openapiclient/src/Soenneker.Upstash.OpenApiClient/Soenneker.Upstash.OpenApiClient.csproj" />
    </ItemGroup>
</Project>
